{
    "namespace": "scoreboard",

  "scoreboard_sidebar": {
    "type": "panel",
	"size": ["100%", "100%"],
    "use_child_anchors": true,
	"$upperkey": "upper", //oh my.. this was so hard to do... 
    "controls": [

	   {
			"upper": {
				"type": "panel",
				"size": ["100%", "100%"],
				"use_child_anchors": true,
				"controls": [
				{
				"scoreboard@scoreboard_top": {
		"bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "source_property_name": "(not ((#objective_sidebar_name - $upperkey) = #objective_sidebar_name))",
              "binding_type": "view",
              "target_property_name": "#visible"
            }
          ]
		}	
					
				}
				]
				
			}
       },
	   {
        "scoreboard@scoreboard_side": {
		"bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "source_property_name": "((#objective_sidebar_name - $upperkey) = #objective_sidebar_name)",
              "binding_type": "view",
              "target_property_name": "#visible"
            }
          ]
		}
       }
    ]
  },

    "scoreboard_top": {
        "type": "panel",
        "size": ["100%c", 0],
        "$scoreboard_offset|default": [-2, 5],
        "$scoreboard_alignment": "top_right",
        "offset": "$scoreboard_offset",
        "anchor_from": "$scoreboard_alignment",
        "anchor_to": "$scoreboard_alignment",
        "ignored": "$scoreboards_feature_disabled",
        "controls": [
            {
                "players": {
                    "type": "stack_panel",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "size": ["100%c", "100%c"],
                    "orientation": "horizontal",
                    "collection_name": "scoreboard_players",
                    "factory": {
                        "name": "player_list_factory",
                        "control_name": "scoreboard.scoreboard_entry"
                    },
                    "bindings": [
                        {
                            "binding_name": "#scoreboard_sidebar_size",
                            "binding_type": "global",
                            "binding_name_override": "#collection_length"
                        }
                    ]
                }
            }
        ],
        "bindings": [
            {
                "binding_name": "#scoreboard_sidebar_visible",
                "binding_type": "global",
                "binding_name_override": "#visible"
            }
        ],
        "variables": [
            {
                "requires": "($pocket_screen)",
                "$scoreboard_offset": [0, 20],
                "$scoreboard_alignment": "top_middle"
            }
        ]
    },

    "scoreboard_entry": {
        "type": "panel",
        "size": ["100%cm + 3px", "100%cm"],
        "controls": [
            {
                "text": {
                    "type": "label",
                    "text": "#player_name_sidebar",
                    "shadow": false,
                    "layer": 2,
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [1, 3],
                    "bindings": [
                        {
                            "binding_name": "#player_name_sidebar",
                            "binding_type": "collection",
                            "binding_collection_name": "scoreboard_players"
                        }
                    ]
                }
            },
            {
                "background": {
                    "type": "image",
                    "texture": "textures/ui/scoreboard/scoreboard_entry",
					"color": "black",
                    "alpha": 0.55,
                    "size": ["100%sm + 4px", "100%sm + 6px"],
                    "offset": [0, 0],
                    "anchor_from": "top_left",
                    "anchor_to": "top_left"
                }
            }
        ]
    },
