{
"namespace": "hud",
  "menu_the_rest_panel": {
    "type": "stack_panel",
    "size": [ "50% + 10px", "100%" ],
    "focus_container": true,
    "use_last_focus": true,
    "focus_nagivation_mode_left": "contained",
      { "menu_button_control@pause.menu_button_control": {} }
    ]
  },
    "menu_background@pause.transparent_background": {
    "size": [ "100% - 2px", "100%c + 8px" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "button_panel": {
          "type": "stack_panel",
          "size": [ "100% - 8px", "100%c" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            { "return_to_game_button@pause.return_to_game_button": {} },
			{ "placeholder1@pause.vertical_padding": {} },
            { "settings_button@pause.settings_button": {} },
            { "placeholder2Y@pause.vertical_padding": {} },
            { "quit_button@pause.quit_button": {} }
          ]
        }
      }
    ]
  },
    "skin_panel_interior": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "controls": [
      {
        "offset_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "controls": [
            {
              "viewer_panel@pause.skin_viewer_panel": {
                "tts_ignore_count": true
              }
            }
          ]
        }
      }

    ]
  }
}