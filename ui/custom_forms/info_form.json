{
    "namespace": "info_form",
    "syodo_info": {
        "type": "stack_panel",
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "size": ["80% - 30px", "80% - 20px"],
        "offset": [0, 15],
        "orientation": "vertical",
        "controls": [
            {
                "title": {
                    "type": "panel",
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "size": [ "100%", 31 ],
                    "controls" :[
                        {
                            "modal_title" :{
                                "type": "label",
                                "font_type": "MinecraftTen",
                                "localize": false,
                                "text": "#title_text",
                                "color": "black",
                                "text_alignment": "center",
                                "font_scale_factor": 2,
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "size": ["default", 30],
                                "offset": [ 0, 0 ],
                                "layer": 53,
                                "shadow": false,
                                "bindings": [
                                    {
                                        "binding_name": "#title_text",
                                        "binding_type": "global"
                                    }
                                ]
                            }
                        },
                        {
                           "close_button@custom_close.syodo_close_button":{}
                        },
						{
							"title_background@social_menu.title_background":{}
						}
                    ]
                }
            },
            {
                "padding": {
                    "type": "panel",
                    "size": ["100%c", 5],
                    "anchor_from": "top_left",
                    "anchor_to": "top_left"
                }
            },
            {
                "contents": {
                    "size": ["100%", "100%"],
                    "layer": 2,
                    "type": "image",
                    "texture": "textures/ui/background/lobby_button_background",
                    "color": "black",
                    "keep_ratio": false,
                    "alpha": 0.6,
                    "controls": [
                        {
                            "syodo_info_form_scroll_panel@info_form.syodo_info_form_scroll_panel": {}
                        },
						{
							"syodo_info_form_grid@info_form.syodo_info_form_grid": {
								"offset": [0, "2.5%"]
							}
						}
                    ]
                }
            }
        ]
    },
    "syodo_info_form_scroll_panel@common.scrolling_panel": {
        "anchor_to": "top_middle",
        "anchor_from": "top_middle",
        "$show_background": false,
        "size": ["80%", "85%"],
        "$scrolling_content": "info_form.syodo_info_form_description_wrapper",
        "$scroll_size": [10, "100% - 40px"],
        "$scrolling_pane_size": ["100%", "100%-7px"],
        "$scrolling_pane_offset": [0, 0],
        "$scroll_bar_right_padding_size": [2, 0]
    },
	
    "syodo_info_form_description_wrapper": {
        "type": "stack_panel",
        "anchor_from": "top_right",
        "anchor_to": "top_right",
        "offset": [0, "7%"],
		"orientation": "vertical",
        "size" :["100%", "107%c"],
        "controls": [
            {
                "modal_description": {
                    "type": "label",
                    "font_type": "Mojangles",
                    "localize": false,
                    "text": "#form_text",
                    "color": "white",
                    "text_alignment": "left",
                    "font_scale_factor": 1,
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "size": ["80%", "default"],
                    "layer": 53,
                    "shadow": true,
                    "bindings": [
                        {
                            "binding_name": "#form_text",
                            "binding_type": "global"
                        }
                    ]
                }
            }
        ]
    },
    "syodo_info_form_grid": {
        "type": "grid",
        "size": ["80%", "20%"],
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "grid_item_template": "info_form.syodo_info_form_entry",
        "grid_rescaling_type": "horizontal",
        "collection_name": "form_buttons",
        "bindings": [
            {
                "binding_name": "#form_button_length",
                "binding_name_override": "#maximum_grid_items"
            }
        ]
    },
    "syodo_info_form_entry":{
        "size": ["100%", "100%"],
        "$background": "textures/ui/info_form/lobby_button_background",
        "type":"panel",
        "controls":[
            {
                "button_please_work@common.button":{
                "size":[
                    "100%",
                    "100%"
                ],
                "layer":1,
                "$pressed_button_name": "button.form_button_click",
                "controls":[
                    {
                        "default@info_form.syodo_info_form_entry_inside":{
                            "$state":"default"
                        }
                    },
                    {
                        "hover@info_form.syodo_info_form_entry_inside":{
                            "$state":"hover"
                        }
                    },
                    {
                        "pressed@info_form.syodo_info_form_entry_inside":{
                            "$state":"pressed"
                        }
                    }
                ],
                "bindings":[
                    {
                        "binding_type":"collection_details",
                        "binding_collection_name":"form_buttons"
                    },
                    {
                        "binding_name":"#form_button_text",
                        "binding_type":"collection",
                        "binding_collection_name":"form_buttons"
                    },
                    {
                        "binding_type":"view",
                        "source_property_name":"(not ((#form_button_text = '') or (#form_button_text = 'loading')))",
                        "target_property_name":"#visible"
                    }
                ]
                }
            }
        ],
        "bindings":[
            {
                "binding_name":"#form_button_text",
                "binding_type":"collection",
                "binding_collection_name":"form_buttons"
            }
        ]
    },
    "syodo_info_form_entry_inside":{
        "type":"stack_panel",
        "anchor_from":"top_left",
        "anchor_to":"top_left",
        "offset":[
            0,
            5
        ],
        "size":[
            "100% - 10px",
            "100% - 20px"
        ],
        "orientation":"vertical",
        "$color|default":"black",
        "variables":[
            {
                "requires":"($state = 'hover')",
                "$color":[
                0.2,
                0.2,
                0.3
                ]
            }
        ],
        "controls":[
            {
                "entry_icon":{
                "size":[
                    "100%",
                    "fill"
                ],
                "layer":10,
                "type":"image",
                "keep_ratio":true,
                "bindings":[
                    {
                        "binding_name":"#form_button_texture",
                        "binding_name_override":"#texture",
                        "binding_type":"collection",
                        "binding_collection_name":"form_buttons"
                    },
                    {
                        "binding_name":"#form_button_texture_file_system",
                        "binding_name_override":"#texture_file_system",
                        "binding_type":"collection",
                        "binding_collection_name":"form_buttons"
                    },
                    {
                        "binding_type":"view",
                        "source_property_name":"(not ((#texture = '') or (#texture = 'loading')))",
                        "target_property_name":"#visible"
                    }
                ]
                }
            },
            {
                "entry_description":{
                "size":[
                    "100%",
                    "100%"
                ],
                "layer":2,
                "type":"image",
                "texture":"textures/ui/background/lobby_button_background",
                "color": "$color",
                "keep_ratio":true,
                "alpha": 0.65,
                "controls":[
                        {
                            "entry_description_label":{
                                "type":"label",
                                "font_type":"default",
                                "text":"#form_button_text",
                                
                                "color":"white",
                                "font_scale_factor":2,
                                "anchor_from":"center",
                                "anchor_to":"center",
								"text_alignment": "center",
                                "size":[
                                "100%",
                                "default"
                                ],
                                "layer":5,
                                "shadow":true,
                                "bindings":[
                                    {
                                        "binding_type":"collection",
                                        "binding_collection_name":"form_buttons",
                                        "binding_condition":"none",
                                        "binding_name":"#form_button_text",
                                        "binding_name_override":"#form_button_text"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    }
}