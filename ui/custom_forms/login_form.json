*********************************************************/
{
  "namespace": "login",
  "syodo_login": {
    "type": "stack_panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [
      "50% - 30px",
      "80% - 20px"
    ],
    "offset": [
      0,
      15
    ],
    "orientation": "vertical",
    "controls": [
      {
        "title": {
          "type": "panel",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [
            "100%",
            31
          ],
          "controls": [
            {
              "modal_title": {
                "type": "label",
                "font_type": "MinecraftTen",
                "localize": false,
                "text": "#title_text",
                "color": "black",
                "text_alignment": "center",
                "font_scale_factor": 2,
                "anchor_from": "center",
                "anchor_to": "center",
                "size": [
                  "default",
                  30
                ],
                "offset": [
                  0,
                  0
                ],
                "layer": 53,
                "shadow": false,
                "bindings": [
                  {
                    "binding_name": "#title_text",
                    "binding_type": "global"
                  }
                ],
                "controls": []
              }
            },
            {
              "close_button@custom_close.syodo_close_button": {
                "alpha": 0.5,
                "offset": [
                  60,
                  5
                ]
              }
            },
            {
              "title_background_t@login.title_background_t": {}
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [
            "100%c",
            5
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "contents": {
          "size": [
            "100%",
            "100%"
          ],
          "layer": 2,
          "type": "image",
          "texture": "textures/ui/background/dailyrewards_background",
          "keep_ratio": false,
          "controls": [
            {
              "syodo_login_scroll_panel@login.syodo_login_scroll_panel": {}
            }
          ]
        }
      }
    ]
  },
  "syodo_login_scroll_panel@common.scroll_view_control": {
    "type": "panel",
    "anchor_to": "top_middle",
    "anchor_from": "top_middle",
    "$show_background": false,
    "size": [
      "80%",
      "97.5%"
    ],
    "$scroll_view_name": "panel",
    "$scrolling_content": "login.syodo_login_grid_wrapper",
    "$scroll_size": [
      0,
      "100%"
    ],
    "$scrolling_pane_size": [
      "100%",
      "100%"
    ],
    "$scrolling_pane_offset": [
      0,
      0
    ],
    "$scroll_bar_right_padding_size": [
      2,
      0
    ]
  },
  "syodo_login_grid_wrapper": {
    "type": "panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "syodo_login_grid@login.syodo_login_grid": {
          "offset": [
            0,
            "5%"
          ]
        }
      }
    ]
  },
  "syodo_login_grid": {
    "type": "grid",
    "size": [
      "100%",
      "90%"
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "grid_item_template": "login.syodo_login_entry",
    "grid_rescaling_type": "horizontal",
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_length",
        "binding_name_override": "#maximum_grid_items"
      }
    ]
  },
  "syodo_login_entry": {
    "size": [
      "16.5%",
      "15.5%"
    ],
    "type": "panel",
    "controls": [
      {
        "button_please_work@common.button": {
          "size": [
            "100%",
            "100%"
          ],
          "layer": 1,
          "$pressed_button_name": "button.form_button_click",
          "controls": [
            {
              "default@login.syodo_login_entry_inside": {
                "$state": "default"
              }
            },
            {
              "hover@login.syodo_login_entry_hover": {
                "$state": "hover"
              }
            },
            {
              "pressed@login.syodo_login_entry_inside": {
                "$state": "pressed"
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#form_button_text = '') or (#form_button_text = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },
  "syodo_login_entry_inside": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [
      "100%y",
      "100%"
    ],
    "orientation": "vertical",
    "$color|default": "black",
    "controls": [
      {
        "background": {
          "size": [
            "100%",
            "100%"
          ],
          "layer": 10,
          "type": "image",
          "keep_ratio": true,
          "texture": "textures/ui/background/dailyreward_reward_background",
          "alpha": 0.8
        }
      },
      {
        "entry_icon": {
          "size": [
            "100%",
            "100%"
          ],
          "layer": 10,
          "type": "image",
          "keep_ratio": true,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "entry_claimed": {
          "size": [
            "50%",
            "50%"
          ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "layer": 12,
          "type": "image",
          "keep_ratio": true,
          "texture": "textures/ui/check",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_condition": "none",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((not ((#form_button_text - 'claimed') = #form_button_text)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "entry_description_label": {
          "type": "label",
          "layer": 11,
          "font_type": "default",
          "text": "#text",
          "line_padding": 2,
          "color": "white",
          "font_scale_factor": 0.8,
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "text_alignment": "right",
          "offset": [
            0,
            -1
          ],
          "size": [
            "100% - 8px",
            "default"
          ],
          "shadow": true,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_condition": "none",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#form_button_text - 'claimed' - 'future' - 'missed' - 'loggedin')",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "entry_missed": {
          "size": [
            "90%",
            "90%"
          ],
          "layer": 12,
          "type": "image",
          "keep_ratio": true,
          "texture": "textures/ui/cancel",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_condition": "none",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((not ((#form_button_text - 'missed') = #form_button_text)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "entry_loggedin": {
          "size": [
            "40%",
            "40%"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 12,
          "type": "image",
          "keep_ratio": true,
          "texture": "textures/ui/icon_saleribbon",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_condition": "none",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((not ((#form_button_text - 'loggedin') = #form_button_text)))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "syodo_login_entry_hover": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [
      "100%y",
      "100%"
    ],
    "orientation": "vertical",
    "$color|default": "black",
    "controls": [
      {
        "default@login.syodo_login_entry_inside": {
          "$state": "default"
        }
      },
      {
        "entry_loggedin": {
          "size": [
            "100%",
            "100%"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 15,
          "type": "image",
          "keep_ratio": true,
          "texture": "textures/ui/equipped_item_border"
        }
      }
    ]
  },
  "title_background_t": {
    "type": "image",
    "texture": "textures/ui/background/dailyrewards_title",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "size": [
      "70%sm + 5%sm",
      31
    ]
  }
}