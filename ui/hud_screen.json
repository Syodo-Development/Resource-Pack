{
  "namespace": "hud",

  "player_list_label": {
    "type": "stack_panel",
    "size": [ 100, 12 ],
    "orientation": "horizontal",
    "controls": [
      {
        "player_avatar": {
          "type": "image",
          "texture": "#texture",
          "size": [ 10, 10 ],
          "texture_file_system": "#texture_source",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "players_collection"
            },
            {
              "binding_name": "#texture_source",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "players_collection"
            },
            {
              "binding_name": "#gamerpic_visible",
              "binding_type": "collection",
              "binding_collection_name": "players_collection",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ 3, 0 ]
        }
      },
      {
        "player_name": {
          "type": "label",
          "text": "#gamertag",
          "size": [ "fill", 10 ],
          "font_type": "Minecraft",

          "bindings": [
            {
              "binding_name": "#gamertag",
              "binding_type": "collection",
              "binding_collection_name": "players_collection"
            }
          ]
        }
      }
    ]
  },
    "chat_label": {
    "type": "label",
    "layer": 31,
    "text": "#text",
    "size": [ "100%", "default" ],
    "shadow": true,
    "localize": false,
    "color": "$chat_text_color",
    "font_type": "default",
    "font_scale_factor": "$chat_font_scale_factor",
    "line_padding": "$chat_line_spacing",
    "anims": [
      "@hud.anim_chat_txt_wait"
    ],
    "bindings": [
      {
        "binding_name": "#chat_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "chat_text_grid",
        "binding_condition": "once"
      }
    ]
  },
  "player_grid": {
    "type": "grid",
    "size": [ "100%", "100%c" ],
    "grid_item_template": "hud.player_list_label",
    "grid_dimension_binding": "#players_grid_dimension",
    "collection_name": "players_collection",
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "bindings": [
      {
        "binding_name": "#players_grid_dimension"
      }
    ]
  },

  "hud_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "tab_playerlist": {
              "type": "button",
              "size": [ "100%", "100%" ],
              "default_control": "default",
              "hover_control": "hover",
              "pressed_control": "pressed",
              "button_mappings": [
                {
                  "from_button_id": "button.scoreboard",
                  "to_button_id": "buttom.scoreboard",
                  "mapping_type": "global"
                }
              ],
              "controls": [
                {
                  "default": {
                    "type": "input_panel",
                    "button_mappings": [
                      {
                        "from_button_id": "button.inventory_left",
                        "to_button_id": "button.hotbar_inventory_left",
                        "mapping_type": "global"
                      },
                      {
                        "from_button_id": "button.inventory_right",
                        "to_button_id": "button.hotbar_inventory_right",
                        "mapping_type": "global"
                      }
                    ]
                  }
                },
                {
                  "hover": {
                    "type": "input_panel",
                    "button_mappings": [
                      {
                        "from_button_id": "button.inventory_left",
                        "to_button_id": "button.hotbar_inventory_left",
                        "mapping_type": "global"
                      },
                      {
                        "from_button_id": "button.inventory_right",
                        "to_button_id": "button.hotbar_inventory_right",
                        "mapping_type": "global"
                      }
                    ]
                  }
                },
                {
                  "pressed": {
                    "type": "stack_panel",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "size": [ 110, "50%" ],
                    "offset": [ 0, "2%" ],
                    "layer": 50,
                    "controls": [
                      {
                        "player_list_listing": {
                          "type": "image",
                          "size": [ "100%", "100%" ],
                          "texture": "textures/ui/scoreboard/scoreboard_entry",
                          "layer": 10,
                          "alpha": 0.55,
                          "color": "black",
                          "anchor_from": "top_middle",
                          "anchor_to": "top_middle",
                          "controls": [
						    {
                              "main": {
                                "type": "image",
							    "offset": [0, "2%"],
                                "texture": "textures/ui/scoreboard/Syodo.png",
                                "anchor_from":"top_middle",
                                "anchor_to": "top_middle",
                                "size": [ "100%", "20%" ],
								"layer": 1
							  }
							},
                            {
                              "player_list_scrolling_panel@common.scrolling_panel": {
                                "size": [ "90%", "65%" ],
								"offset": [0, "25%" ],
								"anchor_from": "top_middle",
								"anchor_to": "top_middle",
                                "$show_background": false,
                                "$scrolling_content": "hud.player_grid",
                                "$always_handle_scrolling": true
                              }                
                            },
							{
								"footer": {
									"text": "#text",
									"text_alignment": "center",
									"anchor_from": "bottom_middle",
									"anchor_to": "bottom_middle",
									"offset": [0, "-3%"],
									"size": [ "90%", "5%" ],
									"type": "label",
									"alpha": 0.7,
									"bindings": [
										{
											"binding_type": "global",
											"binding_name": "#player_list_title"
										},
										{
											"binding_type": "view",
											"source_property_name": "#player_list_title",
											"target_property_name": "#text"
										}
									]
								  }
							}
                          ],
                          "bindings": [
                            {
                              "binding_name": "#hud_visible",
                              "binding_name_override": "#visible",
                              "binding_type": "global"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
				
              ]
            }
          }
        ]
      }
    ]
  },

  "hud_screen": {
    "button_mappings": [
      {
        "from_button_id": "button.scoreboard",
        "to_button_id": "button.scoreboard",
        "mapping_type": "global"
      },
