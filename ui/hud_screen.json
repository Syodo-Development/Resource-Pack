        "mapping_type": "global"
      },
      {
        "from_button_id": "button.slot7",
        "to_button_id": "button.slot_7",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.slot8",
        "to_button_id": "button.slot_8",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.slot9",
        "to_button_id": "button.slot_9",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.slot0",
        "to_button_id": "button.slot_0",
        "mapping_type": "global"
      }
    ]
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
			{
			  "syodo_footer@hud.syodo_footer": {
				"anchor_from": "bottom_left",
				"anchor_to": "bottom_left",
				"font_type": "default",
				"alpha": 0.3,
				"size": [
				  "20%",
				  "4%"
				]
			  }
			}
        ]
      }
    ]
  },
    "syodo_footer": {
    "text": "§bsyodo.xyz",
    "text_alignment": "left",
	"offset": ["1%", 0],
    "type": "label"
  }
}